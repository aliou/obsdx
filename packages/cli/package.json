{
  "name": "@aliou/obsdx-cli",
  "version": "0.0.6",
  "description": "Headless Obsidian vault intelligence CLI",
  "private": true,
  "type": "module",
  "bin": {
    "obsdx": "./dist/main.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aliou/obsdx-base-ast": "workspace:*",
    "@aliou/obsdx-base-engine": "workspace:*",
    "@aliou/obsdx-index": "workspace:*",
    "@bomb.sh/args": "^0.3.1",
    "@bomb.sh/tab": "^0.0.15",
    "@clack/prompts": "^1.3.0",
    "@drizzle-team/brocli": "^0.12.0",
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "yaml": "^2.7.0"
  }
}
