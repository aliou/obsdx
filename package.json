{
  "name": "@aliou/obsdx-workspace",
  "version": "0.0.5",
  "private": true,
  "description": "Headless Obsidian vault intelligence CLI workspace",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "pnpm build && pnpm --dir packages/cli dev",
    "test": "turbo run test",
    "lint": "biome check",
    "format": "biome check --write",
    "bump": "tsx scripts/bump.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "publish:packages": "pnpm --filter @aliou/obsdx-base-ast --filter @aliou/obsdx-base-engine --filter @aliou/obsdx-index publish -r --access public --no-git-checks",
    "release": "pnpm publish:packages"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.8.1",
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@tsdown/exe": "0.22.0",
    "@types/node": "^25.0.0",
    "lefthook": "^2.1.6",
    "tsdown": "0.22.0",
    "tsx": "^4.19.3",
    "turbo": "^2.6.1",
    "typescript": "^6.0.3",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=25.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ],
    "ignoredBuiltDependencies": [
      "lefthook"
    ]
  },
  "packageManager": "pnpm@10.6.4"
}
